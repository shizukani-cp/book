---
import { getCollection } from "astro:content";
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';

const books = await getCollection("books");

books.sort(
  (a, b) =>
    b.data.started
    - a.data.started
);
---
<Layout>
  <main id="pages">
    <div class="cards">
      {books.map((book) => (
        <BookCard book={book} />
      ))}
    </div>
  </main>
</Layout>
